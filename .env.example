# Database Configuration
# DATABASE_URL is automatically set by Render in production.
# Locally, if left blank or unset, SQLite (database.db) will be used as a fallback.
DATABASE_URL=postgresql://username:password@localhost:5432/closetshare

# Email Delivery Configuration (Closet Share automatically tries Resend API -> Brevo API -> Gmail SMTP)
# 1. Resend API (recommended for free hosting/Render): https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_SENDER=onboarding@resend.dev

# 2. Brevo API: https://brevo.com
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=your-verified-sender@example.com
BREVO_SENDER_NAME=Closet Share

# 3. Gmail SMTP Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_SENDER=your-email@gmail.com

# Optional Cloudinary Configuration for Image Uploads
# If left blank, local static/assets storage will be used.
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Cryptographically secure session secret key (generate with `openssl rand -hex 32` or similar)
SECRET_KEY=your-session-secret-key-here
