# Gmail SMTP Configuration for Closet Share
# Copy this file to '.env' and fill in your actual credentials.

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com

# IMPORTANT: Do not use your regular Gmail password. 
# You MUST use a 16-character App Password generated in Google Account settings.
SMTP_PASSWORD=your-gmail-app-password

SMTP_SENDER=your-email@gmail.com

# Resend API Configuration (Alternative to SMTP, works on Render Free Tier)
# Get a free key at https://resend.com
RESEND_API_KEY=re_your_api_key_here
# If using a free Resend tier without a custom domain, you MUST use 'onboarding@resend.dev'
RESEND_SENDER=onboarding@resend.dev

# Cryptographically secure session secret key (generate with `openssl rand -hex 32` or similar)
SECRET_KEY=your-session-secret-key-here
